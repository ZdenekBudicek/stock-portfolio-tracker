# Frontend (Vite) — copy to .env.local and fill in. Never commit real values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Price / sector workers (scripts/*.mjs, run by GitHub Actions — store these as repository secrets)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
TWELVE_DATA_KEY=
FINNHUB_API_KEY=

# Edge function secrets are set in Supabase, not here:
#   supabase secrets set FINNHUB_API_KEY=... TWELVE_DATA_API_KEY=... CRON_SECRET=...
